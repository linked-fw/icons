{
  "name": "@_linked/icons",
  "description": "The Linked icon set: a named, aliased re-export of lucide-react plus a few hand-drawn icons, so every Linked package and app names an icon the same way.",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/icons.git"
  },
  "version": "1.1.5",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "index.d.ts",
  "license": "MPL-2.0",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "linkedPackage": true,
  "scripts": {
    "start": "linked dev",
    "build": "linked build",
    "changeset": "changeset",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "linked",
    "icons",
    "lucide"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.22.8"
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "lucide-react": "^0.439.0 || ^1.0.0",
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  }
}
