{
  "name": "@_linked/icons",
  "description": "The Linked icon set: a named, aliased re-export of lucide-react plus a few hand-drawn icons, so every Linked package and app names an icon the same way.",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/icons.git"
  },
  "version": "1.1.3",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "index.d.ts",
  "license": "MPL-2.0",
  "linkedPackage": true,
  "scripts": {
    "start": "linked dev",
    "build": "rimraf ./lib && npm run build-esm && npm run copy-to-lib",
    "build-esm": "echo \"compiling ESM\" && rimraf ./lib/esm && tsc -p tsconfig-esm.json",
    "copy-to-lib": "echo 'copying CSS + JSON assets to lib folder' && copyfiles -u 1 'src/**/*.css' 'src/**/*.json' lib/esm",
    "changeset": "changeset"
  },
  "keywords": [
    "linked",
    "icons",
    "lucide"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.22.8"
  },
  "devDependencies": {
    "@_linked/cli": "^1.2",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "copyfiles": "^2.4.1",
    "lucide-react": "^0.439.0",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.4",
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  }
}
